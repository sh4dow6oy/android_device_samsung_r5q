# -- RECOVERY & DEBUGGING --
ro.debuggable=1
ro.secure=0
ro.build.selinux=1
ro.allow.mock.location=1
persist.sys.usb.config=adb
sys.usb.controller=a600000.dwc3
persist.sys.disable_rescue=true
