/boot           emmc      /dev/block/bootdevice/by-name/boot                   flags=display=boot;backup=1;flashimg=1
/recovery       emmc      /dev/block/bootdevice/by-name/recovery               flags=display=recovery;backup=1;flashimg=1
/system         erofs     system                                               flags=display="System";logical;first_stage_mount
/vendor         ext4      vendor                                               flags=display="Vendor";logical;first_stage_mount
/product        ext4      product                                              flags=display="Product";logical;first_stage_mount
/odm            ext4      odm                                                  flags=display="Odm";logical;first_stage_mount
/data           f2fs      /dev/block/bootdevice/by-name/userdata               flags=display=data;fileencryption=ice:aes-256-cts
/cache          ext4      /dev/block/bootdevice/by-name/cache                  flags=display=cache
/efs            ext4      /dev/block/bootdevice/by-name/efs                    flags=display=efs;backup=1
/sec_efs        ext4      /dev/block/bootdevice/by-name/sec_efs                flags=display=sec_efs;backup=1
/modem          emmc      /dev/block/bootdevice/by-name/apnhlos                flags=display=modem;backup=1
/mdm            emmc      /dev/block/bootdevice/by-name/modem                  flags=display=mdm;backup=1
/dsp            emmc      /dev/block/bootdevice/by-name/dsp                    flags=display=dsp
/misc           emmc      /dev/block/bootdevice/by-name/misc                   flags=display=misc
/keydata        ext4      /dev/block/bootdevice/by-name/keydata                flags=display=keydata
/keyrefuge      ext4      /dev/block/bootdevice/by-name/keyrefuge              flags=display=keyrefuge
/dtbo           emmc      /dev/block/bootdevice/by-name/dtbo                   flags=display=dtbo;backup=1;flashimg=1
/vbmeta_samsung emmc      /dev/block/bootdevice/by-name/vbmeta_samsung         flags=display=vbmeta_samsung;backup=1
/vbmeta_system  emmc      /dev/block/bootdevice/by-name/vbmeta_system          flags=display=vbmeta_system;backup=1
/external_sd    vfat      /dev/block/mmcblk0p1 /dev/block/mmcblk0              flags=display="MicroSD";storage;wipeui;removable
/usb-otg        vfat      /dev/block/sdg1      /dev/block/sdg
